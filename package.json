{
  "name": "@bricks-soft/capacitor-thermal-printer",
  "version": "1.0.0",
  "description": "ESC/POS receipt printing over Bluetooth, TCP and USB for Capacitor.",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Sources/",
    "Package.swift",
    "BricksSoftCapacitorThermalPrinter.podspec"
  ],
  "author": "Bricks Soft",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bricks-soft/capacitor-thermal-printer.git"
  },
  "bugs": {
    "url": "https://github.com/bricks-soft/capacitor-thermal-printer/issues"
  },
  "homepage": "https://github.com/bricks-soft/capacitor-thermal-printer#readme",
  "keywords": [
    "capacitor",
    "plugin",
    "thermal",
    "printer",
    "escpos"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc && rollup -c rollup.config.mjs",
    "test": "npm run build && node --test test/*.mjs",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@capacitor/core": "8.5.2",
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "rimraf": "^6.1.3",
    "rollup": "^4.53.2",
    "typescript": "~5.9.3"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0 <9.0.0"
  },
  "capacitor": {
    "android": {
      "src": "android"
    },
    "ios": {
      "src": "ios"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
