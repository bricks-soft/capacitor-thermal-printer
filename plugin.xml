<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        id="thermal-printer-cordova-plugin" version="1.1.0">
    <name>Cordova Plugin ESCPOS Printer</name>
    <description>Cordova wrapper for ESC/POS Thermal Printer library</description>
    <license>Apache 2.0</license>
    <keywords>cordova,android,ios,thermal,printer,esc,pos,esc/pos</keywords>
    <js-module src="www/thermal-printer.js" name="ThermalPrinterPlugin">
        <clobbers target="ThermalPrinter" />
    </js-module>
    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="ThermalPrinter">
                <param name="android-package" value="de.paystory.thermal_printer.ThermalPrinterCordovaPlugin" />
            </feature>
        </config-file>

        <config-file parent="/*" target="AndroidManifest.xml">
            <uses-feature android:name="android.hardware.usb.host" />
            <uses-permission android:maxSdkVersion="30" android:name="android.permission.BLUETOOTH" />
            <uses-permission android:name="android.permission.INTERNET" />
            <uses-permission android:maxSdkVersion="30" android:name="android.permission.BLUETOOTH_ADMIN" />
            <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
            <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
        </config-file>

        <source-file src="src/android/ThermalPrinterCordovaPlugin.java" target-dir="src/de/paystory/thermal_printer" />
        <framework src="src/android/build.gradle" custom="true" type="gradleReference" />
    </platform>
    <platform name="ios">
        <config-file target="config.xml" parent="/*">
            <feature name="ThermalPrinter">
                <param name="ios-package" value="ThermalPrinterCordovaPlugin" />
            </feature>
        </config-file>

        <preference name="BLUETOOTH_USAGE_DESCRIPTION" default="Bluetooth is used to connect to receipt printers." />
        <config-file target="*-Info.plist" parent="NSBluetoothAlwaysUsageDescription">
            <string>$BLUETOOTH_USAGE_DESCRIPTION</string>
        </config-file>

        <source-file src="src/ios/Plugin/ThermalPrinterCordovaPlugin.swift" />
        <source-file src="src/ios/Sources/ThermalPrinter/EscPosBarcode.swift" />
        <source-file src="src/ios/Sources/ThermalPrinter/EscPosBitmap.swift" />
        <source-file src="src/ios/Sources/ThermalPrinter/EscPosBluetooth.swift" />
        <source-file src="src/ios/Sources/ThermalPrinter/EscPosBluetoothConnection.swift" />
        <source-file src="src/ios/Sources/ThermalPrinter/EscPosBluetoothRules.swift" />
        <source-file src="src/ios/Sources/ThermalPrinter/EscPosCharsetEncoding.swift" />
        <source-file src="src/ios/Sources/ThermalPrinter/EscPosDeviceConnection.swift" />
        <source-file src="src/ios/Sources/ThermalPrinter/EscPosJavaCompat.swift" />
        <source-file src="src/ios/Sources/ThermalPrinter/EscPosKnownPrinterStore.swift" />
        <source-file src="src/ios/Sources/ThermalPrinter/EscPosPrinter.swift" />
        <source-file src="src/ios/Sources/ThermalPrinter/EscPosPrinterCommands.swift" />
        <source-file src="src/ios/Sources/ThermalPrinter/EscPosPrinterSize.swift" />
        <source-file src="src/ios/Sources/ThermalPrinter/EscPosQRCode.swift" />
        <source-file src="src/ios/Sources/ThermalPrinter/EscPosQueue.swift" />
        <source-file src="src/ios/Sources/ThermalPrinter/EscPosTcpConnection.swift" />
        <source-file src="src/ios/Sources/ThermalPrinter/PrinterTextParser.swift" />
        <source-file src="src/ios/Sources/ThermalPrinter/ThermalPrinterService.swift" />

        <framework src="CoreBluetooth.framework" />
        <framework src="CoreImage.framework" />
        <framework src="ImageIO.framework" />
        <framework src="Network.framework" />
    </platform>
</plugin>
